---
import ContentWrapper from "@/components/ContentWrapper";
import { Accordion } from "@/components/ui/AccordionWrapper";
import { getCollection } from "astro:content";

let faqData: { question: string; answer: string }[] = [];

try {
  const faqEntries = await getCollection("faq");
  faqData = faqEntries.map((entry: any) => ({
    question: entry.data.question,
    answer: entry.data.answer,
  }));
} catch (error) {
  console.warn("FAQ content collection not found, using fallback data");
}
---

<section
  id="faq"
  class="relative flex w-full scroll-m-5 flex-col items-center justify-center overflow-hidden bg-white py-18 sm:py-24 md:py-28 lg:py-36"
>
  <ContentWrapper
    className="flex w-full flex-col items-center justify-center gap-10 sm:gap-14 md:gap-16"
  >
    <h2 class="text-primary text-center text-2xl/9 font-medium">FAQ</h2>

    <Accordion data={faqData} client:idle />
  </ContentWrapper>
</section>
