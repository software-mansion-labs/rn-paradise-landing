---
import ContentWrapper from "@/components/ContentWrapper";
import ContactForm from "@/components/ContactForm";
import { getEntry } from "astro:content";

const siteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY || "";
const contactData = await getEntry("contact", "contact");
const discordUrl = contactData?.data.discordUrl || "";
---

<section
  id="contact"
  class="bg-beige-4 relative flex w-full scroll-m-5 flex-col items-center justify-center overflow-hidden pt-18 pb-20 sm:pt-24 sm:pb-24 md:pt-28 md:pb-28 lg:pt-36 lg:pb-40"
>
  <ContentWrapper
    className="flex w-full flex-col items-center justify-center gap-10 sm:gap-14 md:gap-16"
  >
    <ContactForm siteKey={siteKey} discordUrl={discordUrl} client:load />
  </ContentWrapper>
</section>
