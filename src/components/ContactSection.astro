---
import ContentWrapper from "@/components/ContentWrapper";
import ContactForm from "@/components/ContactForm";

const siteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY || "";
---

<section
  id="contact"
  class="bg-sea-blue relative flex w-full scroll-m-5 flex-col items-center justify-center overflow-hidden pt-18 pb-20 sm:pt-24 sm:pb-24 md:pt-28 md:pb-28 lg:pt-36 lg:pb-40"
>
  <ContentWrapper
    className="flex w-full flex-col items-center justify-center gap-10 sm:gap-14 md:gap-16"
  >
    <h2 class="text-primary text-center text-2xl/9 font-medium">
      Have more questions? Contact us here!
    </h2>

    <ContactForm siteKey={siteKey} client:load />
  </ContentWrapper>
</section>
