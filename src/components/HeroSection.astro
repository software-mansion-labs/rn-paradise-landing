---
import ContentWrapper from "@/components/ContentWrapper";
import { getEntry } from "astro:content";
import EditionBadge from "@/components/EditionBadge";
import { Button } from "@/components/ui/button";

const heroData = await getEntry("hero", "hero");
const generalData = await getEntry("general", "general");

const eventDate = heroData?.data.eventDate || "";
const eventLocation = heroData?.data.eventLocation || "";
const editionNumber = parseInt(generalData?.data.editionNumber || "2");

const featureCardIcons = [
  "assets/hero-icons/ReactNative.svg",
  "assets/hero-icons/People.svg",
  "assets/hero-icons/House.svg",
];
---

<section
  id="hero"
  class="relative flex w-full scroll-m-5 flex-col items-center justify-center overflow-visible pb-32"
>
  {/* Background */}
  <style>
    @media (max-width: 258px) {
      .hero-bg {
        background-position: center calc(50% + 20px) !important;
      }
    }
    @media (min-width: 769px) {
      .hero-bg {
        background-position: center calc(50% - 170px) !important;
      }
    }
    @media (min-width: 1025px) {
      .hero-bg {
        background-position: center calc(50% - 300px) !important;
      }
    }
    @media (min-width: 1440px) {
      .hero-bg {
        background-position: center calc(50% - 300px) !important;
      }
    }
    @media (min-width: 1640px) {
      .hero-bg {
        background-position: center calc(50% - 500px) !important;
      }
    }
    @media (min-width: 1920px) {
      .hero-bg {
        background-position: center calc(50% - 600px) !important;
      }
    }
    @media (min-width: 2200px) {
      .hero-bg {
        background-position: center calc(50% - 700px) !important;
      }
    }
  </style>
  <div
    class="hero-bg absolute inset-0"
    style="background-image: url('/assets/hero-bg.webp'); background-attachment: fixed; background-position: center; background-repeat: no-repeat; background-size: cover; height: calc(100% + 128px);"
  >
  </div>

  {/* Hero content */}
  <div
    class="relative z-10 flex w-full flex-col items-center justify-center pt-34 pb-40"
  >
    <ContentWrapper
      className="flex w-full flex-col items-center justify-center"
    >
      <p class="text-primary/80 mb-4 text-center text-sm sm:text-base">
        Software Mansion Presents:
      </p>

      <div class="relative">
        <h1 class="text-primary relative z-2 text-center text-xl">
          <span class="text-beige-light block">React Native</span>
          <span
            class="text-primary font-cookie block -translate-y-5 text-[72px] whitespace-nowrap sm:-translate-x-1 sm:-translate-y-7 sm:text-[84px] md:translate-x-1 md:-translate-y-8 md:text-[104px] lg:translate-x-0"
            >Paradise</span
          >
        </h1>
        {
          editionNumber && (
            <EditionBadge
              editionNumber={editionNumber}
              className="bottom-6 -right-8 sm:bottom-7 md:-right-11 md:bottom-9 z-1"
              variant="default"
            />
          )
        }
      </div>

      <div
        class="-mt-2 flex max-w-[80%] flex-col items-center justify-center gap-12 sm:max-w-[80%] md:max-w-[45%] lg:max-w-[30%]"
      >
        <div class="flex flex-col items-center justify-center gap-4">
          <p
            class="text-primary/80 text-center text-sm leading-relaxed sm:text-base md:max-w-2xl"
          >
            Join our advanced React Native workshops with core contributors – in
            the best learning environment possible.
          </p>

          <div class="flex flex-col items-center gap-2.5 sm:flex-row sm:gap-4">
            {
              eventDate && (
                <div class="text-primary/80 flex items-center gap-2 text-xs">
                  <img
                    src={"/assets/hero-icons/Calendar.svg"}
                    alt={"calendar"}
                    class="h-5 w-5"
                  />
                  <span>{eventDate}</span>
                </div>
              )
            }
            {
              eventLocation && (
                <div class="text-primary/80 flex items-center gap-2 text-xs">
                  <img
                    src={"/assets/hero-icons/MapPin.svg"}
                    alt={"map pin"}
                    class="h-5 w-5"
                  />
                  <span>{eventLocation}</span>
                </div>
              )
            }
          </div>
        </div>

        <a href="#reservation">
          <Button variant="secondary" size="lg"> Book now </Button>
        </a>
      </div>

      <div class="mt-15 flex flex-col items-center">
        <img
          src={"assets/hero-icons/HeroArrow.svg"}
          alt={"arrow"}
          class="h-full w-full"
        />
      </div>
    </ContentWrapper>
  </div>
</section>
