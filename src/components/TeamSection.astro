---
import ContentWrapper from "@/components/ContentWrapper";
import TeamCarousel from "@/components/ui/TeamCarousel";
import { getCollection } from "astro:content";

let members: {
  name: string;
  role: string;
  company?: string;
  image: string;
  bio?: string;
  social?: { twitter?: string; github?: string };
}[] = [];

try {
  const teamMembers = await getCollection("team");
  members = teamMembers
    .map((entry: any) => ({
      name: entry.data.name,
      role: entry.data.role,
      company: entry.data.company,
      image: entry.data.image,
      bio: entry.data.bio,
      social: entry.data.social,
      order: entry.data.order ?? 999,
    }))
    .sort((a, b) => a.order - b.order)
    .map(({ order, ...rest }) => rest);
} catch (error) {
  console.warn("Team content collection not found");
}
---

<section
  id="team"
  class="relative flex w-full scroll-m-5 flex-col items-center justify-center overflow-hidden bg-white pt-18 pb-20 sm:pt-24 sm:pb-24 md:pt-28 md:pb-28 lg:pt-36 lg:pb-40"
>
  <ContentWrapper
    className="flex w-full flex-col items-center justify-center gap-8"
  >
    <h2 class="text-primary text-center text-lg font-bold">Our instructors</h2>

    {
      members.length > 0 && (
        <div class="w-full overflow-visible sm:overflow-hidden">
          <TeamCarousel members={members} client:load />
        </div>
      )
    }
  </ContentWrapper>
</section>
