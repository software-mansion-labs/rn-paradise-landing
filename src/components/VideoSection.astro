---
import ContentWrapper from "@/components/ContentWrapper";
import { getCollection } from "astro:content";

const videoSectionEntries = await getCollection("videoSection");
const videoSection = videoSectionEntries[0];
const backgroundVideo = videoSection?.data.backgroundVideo;
---

<section
  class="relative flex h-[60vh] max-h-[800px] w-full flex-col items-center justify-center overflow-hidden bg-black"
  aria-label="Hero section with background video and event description"
>
  <div class="absolute inset-0 z-0 h-full w-full overflow-hidden">
    <video
      autoplay
      loop
      muted
      playsinline
      class="h-full w-full object-cover object-center"
      aria-hidden="true"
    >
      <source src={backgroundVideo} type="video/mp4" />
    </video>
  </div>

  <div class="absolute inset-0 z-[1] bg-black/60"></div>

  <ContentWrapper
    className="relative z-20 flex h-full w-full flex-col items-center justify-center px-6"
  >
    <div
      class="text-beige-3 flex max-w-3xl flex-col items-center justify-center gap-6 text-center"
    >
      <h2 class="text-lg font-bold">We make unforgettable experiences.</h2>

      <p class="text-md md:max-w-[85%]">
        We've spent years creating App.js Conf and RTC.On, events that bring
        together hundreds of developers each year.
      </p>
    </div>
  </ContentWrapper>
</section>
