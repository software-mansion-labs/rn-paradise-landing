---
import ContentWrapper from "@/components/ContentWrapper";
import { getEntry } from "astro:content";
import PolaroidCard from "@/components/PolaroidCard";
import { parseToHtml } from "@/utils/textParser";

const aboutData = await getEntry("about", "about");

const featureCardIcons = [
  "assets/hero-icons/ReactNative.svg",
  "assets/hero-icons/People.svg",
  "assets/hero-icons/House.svg",
];

const featureCards = (aboutData?.data.featureCards || [])
  .map((card: any) => ({
    text: card.text || "",
    order: typeof card.order === "number" ? card.order : 999,
  }))
  .sort((a: any, b: any) => a.order - b.order)
  .map(({ order, ...rest }: any, index: number) => ({
    ...rest,
    icon: featureCardIcons[index] || featureCardIcons[0],
  }));

const polaroidGalleryRotations = [-10, -0, 12, -5];

const polaroidGallery = (aboutData?.data.polaroidGallery || [])
  .map((item: any) => ({
    image: item.image || "",
    caption: item.caption || "",
    order: typeof item.order === "number" ? item.order : 999,
  }))
  .sort((a: any, b: any) => a.order - b.order)
  .map(({ order, ...rest }: any) => rest);
---

<section
  id="about"
  class="relative -mt-32 flex w-full scroll-m-5 flex-col items-center justify-center overflow-hidden bg-transparent"
>
  <div
    class="bg-beige-1 relative z-10 w-full rounded-t-[64px] pt-18 pb-12 sm:pt-24 sm:pb-18 md:pt-28 md:pb-32 lg:pt-32 lg:pb-40"
  >
    <ContentWrapper
      className="flex w-full flex-col items-center justify-center"
    >
      <h2 class="text-primary mb-12 text-center text-lg font-bold md:mb-20">
        What can you expect?
      </h2>

      {/* Feature Cards */}
      <div class="mb-12 grid w-full grid-cols-1 gap-4 md:grid-cols-3 md:gap-4">
        {
          featureCards.map((card: any, index: number) => (
            <div class="flex flex-col items-start gap-4 rounded-lg bg-white px-10 pt-6 pb-10 shadow-sm">
              <div class="bg-badge-yellow flex h-14 w-14 items-center justify-center rounded-full text-2xl">
                <img src={card.icon} alt={"calendar"} class="h-6 w-6" />
              </div>
              <p
                class="text-primary self-center text-sm leading-relaxed"
                set:html={parseToHtml(card.text)}
              />
            </div>
          ))
        }
      </div>

      {/* Polaroid Gallery */}
      <div class="relative flex w-full items-center justify-center px-2">
        <div
          class="relative mx-auto flex max-w-[1200px] flex-wrap items-center justify-center md:flex-nowrap"
        >
          {
            polaroidGallery.map((polaroid: any, index: number) => {
              const translateY = index % 2 === 0 ? -10 : 10;
              const zIndex = polaroidGallery.length - index;

              return (
                <div
                  class="relative -mx-20 -my-15 sm:-mx-15 sm:-my-15 md:-mx-20 md:w-auto"
                  style={`transform: rotate(${polaroidGalleryRotations[index]}deg) translateY(${translateY}px); z-index: ${zIndex}; transform-origin: center center;`}
                >
                  <div class="scale-[0.6] [--card-scale:0.6] md:scale-[0.66] md:[--card-scale:0.66]">
                    <PolaroidCard
                      image={
                        polaroid.image ||
                        "/media/previous-section-carousel-2.webp"
                      }
                      caption={polaroid.caption}
                      isMain={true}
                      zIndex={zIndex}
                      textScale={{ medium: 1.515 }}
                      client:load
                    />
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </ContentWrapper>
  </div>
</section>
