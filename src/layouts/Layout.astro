---
import "@/styles/global.css";
import { Font } from "astro:assets";
import { PUBLIC_RECAPTCHA_SITE_KEY } from "astro:env/server";
import { Captcha } from "@/utils/recaptcha.tsx";
import { Header } from "@/components/ui/Header";
import { Footer } from "@/components/ui/Footer";

interface Props {
  title: string;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.webp" />
    <meta name="generator" content={Astro.generator} />
    <title>React Native Paradise - RN workshops in Croatia</title>
    <meta
      name="description"
      content="Want to learn React Native from top experts under the sun? Join our week-long retreat for React Native & chill!"
    />
    <meta
      name="keywords"
      content="react native reanimated
react native gesture handler
react native expo
expo reactnative
react native tutorial
react native course
react native native modules
react native coding
react native app
create react native app
react native paradise"
    />

    <Font cssVariable="--font-aeonik" preload />
    <Font cssVariable="--font-cookie" preload />

    <script>
      // wait for reCAPTCHA to load the badge and hide it
      const hideBadge = () => {
        const badge = document.querySelector(
          ".grecaptcha-badge"
        ) as HTMLElement | null;
        if (badge) {
          badge.style.opacity = "0";
          badge.style.visibility = "hidden";
          badge.style.pointerEvents = "none";
        }
        requestAnimationFrame(hideBadge);
      };
      hideBadge();
    </script>

    <!-- Google Tag Manager -->
    <script
      is:inline
      set:html={`  
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != "dataLayer" ? "&l=" + l : "";
          j.async = true;
          j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, "script", "dataLayer", "GTM-PMLFF7CX");
      `}
    />
    <!-- End Google Tag Manager -->
  </head>
  <body class="font-primary">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-PMLFF7CX"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->

    <Header client:load />
    <slot />
    <Footer client:load />

    <Captcha siteKey={PUBLIC_RECAPTCHA_SITE_KEY} client:load />
  </body>
</html>
